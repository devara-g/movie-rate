# ==========================================================
# CINEHEARTH ENVIRONMENT VARIABLES
# ==========================================================

# 1. Supabase Backend (Get from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. TMDB (The Movie Database) API (Get free key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
